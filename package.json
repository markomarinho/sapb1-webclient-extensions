{
  "name": "sapb1-webclient-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo of on-premise SAP Business One (HANA) Web Client extensions",
  "workspaces": [
    "extensions/*",
    "extensions/*/packages/*"
  ],
  "scripts": {
    "new": "node scripts/new-extension.mjs",
    "list": "node scripts/ext.mjs --list",
    "build": "node scripts/ext.mjs build",
    "build:mtar": "node scripts/ext.mjs build:mtar",
    "test": "node scripts/ext.mjs test",
    "typecheck": "node scripts/ext.mjs typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
