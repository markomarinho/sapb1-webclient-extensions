# ============================================================================
# SAP B1 Web Client — Delivery Note to Invoice Extension
# Copy this file to .env and fill in your internal server values.
# ============================================================================

PORT=4020
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5174

# B1_MODE: "mock" (offline local dev dataset) or "live" (SAP B1 Service Layer)
B1_MODE=mock

# EMAIL_MODE: "mock" (records emails locally for preview) or "smtp" (real SMTP server)
EMAIL_MODE=mock

# Local SQLite database for automation settings, idempotency locks, email history & audit log
SQLITE_DB_PATH=./data/delivery-to-invoice.sqlite

# ============================================================================
# SAP Business One Service Layer (Used when B1_MODE=live)
# ============================================================================
B1_SERVICE_LAYER_URL=https://b1.internal.example.local:50000/b1s/v1
B1_COMPANY_DB=SBO_COMPANY_PT
B1_REJECT_UNAUTHORIZED_TLS=true

# Technical account used by the background scheduler (manual UI calls forward B1SESSION)
B1_TECH_USER=
B1_TECH_PASSWORD=

# Optional Business Partner UDFs
# Flag ('Y'/'N') controlling which customers are picked up by the automatic scheduler
B1_BP_AUTO_INVOICE_UDF=U_AutoInvoice
# Optional dedicated BP UDF for invoice recipient email (falls back to EmailAddress -> Contact)
B1_BP_INVOICE_EMAIL_UDF=

# ============================================================================
# Crystal Reports PDF Export via SAP B1 API Gateway
# ============================================================================
# PDF_SOURCE: "builtin" (internal PDF generator) or "gateway" (Crystal Reports via API Gateway)
PDF_SOURCE=builtin
B1_GATEWAY_URL=https://b1.internal.example.local:50000
# Optional DBInstance if required by your API Gateway login
B1_GATEWAY_DB_INSTANCE=
# Crystal Report Layout DocCode from SAP B1 RDOC table (e.g. INV20004 for A/R Invoice)
B1_INVOICE_DOC_CODE=INV20004
# If true, falls back to built-in PDF when the API Gateway is unreachable
B1_GATEWAY_FALLBACK_BUILTIN=false

# ============================================================================
# Company Header Details for Generated Invoice PDF (builtin / fallback)
# ============================================================================
COMPANY_NAME=Empresa Lusitana, S.A.
COMPANY_NIF=PT501234567
COMPANY_ADDRESS=Av. da Liberdade 120, 1250-146 Lisboa

# ============================================================================
# SMTP Settings (Defaults — can also be edited in the UI Settings dialog)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=faturacao@empresa.local
