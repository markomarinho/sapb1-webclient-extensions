# ============================================================================
# SAP B1 Web Client Bank Reconciliation Extension (On-Premise / SAP HANA)
# Copy this file to .env and fill in your internal server values.
# ============================================================================

PORT=4010
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Mode: "mock" (offline local dev with realistic PT SAP B1 dataset) or "live" (HANA + Service Layer)
B1_MODE=mock

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of local vault secrets
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local SQLite path for bank statement staging, idempotency, and immutable audit log
SQLITE_DB_PATH=./data/reconciliation.sqlite

# ============================================================================
# Direct Read-Only SAP HANA Connection (Used when B1_MODE=live)
# IMPORTANT: Use ONLY the restricted SELECT-only user created by sql/01_create_hana_readonly_user.sql
# ============================================================================
HANA_HOST=hana.internal.example.local
HANA_PORT=30015
HANA_SCHEMA=SBO_COMPANY_PT
HANA_READONLY_USER=B1_RECON_RO
HANA_READONLY_PASSWORD=
HANA_ENCRYPT=true
HANA_SSL_VALIDATE_CERT=true

# Optional UDF names on OINV / OPCH if your SAP B1 database stores Multibanco references in UDFs
HANA_UDF_MB_ENTITY=
HANA_UDF_MB_REF=

# ============================================================================
# SAP Business One Service Layer (Used for Session Auth & All Writes when B1_MODE=live)
# ============================================================================
B1_SERVICE_LAYER_URL=https://b1.internal.example.local:50000/b1s/v1
B1_COMPANY_DB=SBO_COMPANY_PT
B1_REJECT_UNAUTHORIZED_TLS=true

# Optional fallback technical account if not forwarding browser B1SESSION cookie directly
B1_TECH_USER=
B1_TECH_PASSWORD=
